# Clé API Anthropic (Claude) — reste UNIQUEMENT côté serveur, jamais exposée au navigateur.
# Obtention : https://console.anthropic.com/ > Settings > API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Clé API Resend (envoi d'email) — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Adresse qui reçoit chaque estimation envoyée par un client
EMAIL_DESTINATAIRE=contact@ijhtransport.com

# Adresse d'expédition (doit appartenir à un domaine vérifié dans Resend)
# Optionnel : si absent, une valeur par défaut est utilisée.
EMAIL_EXPEDITEUR=IJH Transport <estimation@ijhtransport.com>
